# --- secrets and environment (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.crt
*.cer
secrets/
*secret*
*credentials*
keys.json

# --- this repository is documentation only: block accidental code artefacts ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
node_modules/
dist/
build/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

