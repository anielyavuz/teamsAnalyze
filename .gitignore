*.dump
*.sql
*.sql.gz
*.backup
*.bak
*.csv
output.html
*.sqlite
*.db

# --- logs ---
*.log
logs/

# --- screenshots and images (only curated images under docs/img are allowed) ---
*.png
*.jpg
*.jpeg
*.gif
*.webp
!docs/img/**

